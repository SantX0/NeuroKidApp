# ============================================================
#  NeuroKid — .gitignore (raiz do projeto)
#  Hardening DevSecOps: segredos, dependências, cache e lixo de SO
# ============================================================


# ------------------------------------------------------------
# 1. SEGURANÇA MÁXIMA — variáveis de ambiente e segredos
#    Bloqueia .env em QUALQUER nível (raiz, backend/, frontend/,
#    subpastas futuras) e todas as variações de ambiente.
#    Regra de ouro: segredo nunca entra no histórico do Git.
# ------------------------------------------------------------
.env
.env.*
**/.env
**/.env.*
*.env

# Exceções: templates SEM valores reais, úteis para onboarding
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template

# Outros portadores de credenciais (chaves, tokens, certificados)
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*credentials*.json
*token*.json
secrets.json
service-account*.json
google-services.json
GoogleService-Info.plist

# Credenciais de teste geradas localmente pelos agentes
memory/test_credentials.md


# ------------------------------------------------------------
# 2. DEPENDÊNCIAS E PACOTES — nunca versionar artefatos pesados
# ------------------------------------------------------------
# Node / Expo (frontend e qualquer backend JS)
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn/install-state.gz

# Python — ambientes virtuais
.venv/
venv/
env/
ENV/
**/.venv/
**/venv/
pip-wheel-metadata/
*.egg-info/
.env.example



# ------------------------------------------------------------
# 3. COMPILADOS, CACHE DE INTERPRETADOR E TESTES
# ------------------------------------------------------------
# Python
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# JavaScript / TypeScript
*.tsbuildinfo
.eslintcache
coverage/
.cache/
.metro-cache/
.metro-health-check*
expo-env.d.ts

# Builds e saídas de empacotamento
dist/
build/
out/
web-build/
.expo/
android/
ios/
*.apk
*.aab
*.ipa


# ------------------------------------------------------------
# 4. SISTEMA OPERACIONAL, EDITORES E LOGS INÚTEIS
# ------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# Editores / IDEs
.idea/
.vscode/
*.swp
*.swo
*.orig.*

# Logs e dumps
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb


# ------------------------------------------------------------
# 5. ARTEFATOS LOCAIS DO PROJETO (gerados por execução/testes)
#    Mantemos .emergent/ versionado — a plataforma precisa dele —
#    ignorando apenas o estado transitório de execução.
# ------------------------------------------------------------
.emergent/**/*.log
test_reports/
tests/__pycache__/
.ipynb_checkpoints/

# Arquivos grandes / compactados nunca vão para o repositório
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
*.pack
*.deb
*.dylib

#Para preocação de arquivos sensiveis ou importantes para o projeto
# === CONFIGURAÇÕES DO PROJETO LOCAL ===
.env
.env.*
.vscode/

# === MARCADORES E SCRIPT CACHES (.emergent) ===
.emergent/markers/
.emergent/cron/applied.hash

# === BACKEND (Python & Pytest) ===
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# === FRONTEND (Node, Yarn & Expo) ===
node_modules/
.expo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
credentials.json
.credentials
